class Direction(enum.Enum):
    TO = 0

    DOWNTO = 1

class Range:
    @overload
    def __init__(self, left: int, direction: Direction, right: int) -> None: ...
    @overload
    def __init__(self, left: int, direction: str, right: int) -> None: ...
    @overload
    def __init__(self, left: int, right: int) -> None: ...
    def to_range(self) -> object: ...
    @staticmethod
    def from_range(range: object) -> Range: ...
    @property
    def left(self) -> int: ...
    @property
    def right(self) -> int: ...
    @property
    def direction(self) -> str: ...
    def __len__(self) -> int: ...
    def __contains__(self, arg: int, /) -> bool: ...
    def __iter__(self) -> Iterator: ...
    def __reversed__(self) -> Iterator: ...
    @overload
    def __getitem__(self, arg: int, /) -> int: ...
    @overload
    def __getitem__(self, arg: slice, /) -> Range: ...
    def __eq__(self, arg: object, /) -> object: ...
    def __hash__(self) -> int: ...
    def __repr__(self) -> str: ...
    @overload
    def index(self, arg: int, /) -> int: ...
    @overload
    def index(self, arg0: int, arg1: int, /) -> int: ...
    @overload
    def index(self, arg0: int, arg1: int, arg2: int, /) -> int: ...
    def count(self, arg: int, /) -> int: ...
    def __copy__(self) -> Range: ...
    def __deepcopy__(self, arg: object, /) -> Range: ...

class LogicArray:
    def __init__(self, value: object, range: object | None = None) -> None: ...
    @staticmethod
    def from_unsigned(
        value: object, range: object, *, on_overflow: str = "error"
    ) -> LogicArray: ...
    @staticmethod
    def from_signed(
        value: object, range: object, *, on_overflow: str = "error"
    ) -> LogicArray: ...
    @staticmethod
    def from_bytes(
        value: object, range: object | None = None, *, byteorder: str
    ) -> LogicArray: ...
    def to_unsigned(self) -> object: ...
    def to_signed(self) -> object: ...
    def to_bytes(self, *, byteorder: str) -> bytes: ...
    @property
    def integer(self) -> object: ...
    @integer.setter
    def integer(self, arg: int, /) -> None: ...
    @property
    def signed_integer(self) -> object: ...
    @signed_integer.setter
    def signed_integer(self, arg: int, /) -> None: ...
    @property
    def binstr(self) -> str: ...
    @binstr.setter
    def binstr(self, arg: str, /) -> None: ...
    @property
    def buff(self) -> bytes: ...
    @buff.setter
    def buff(self, arg: object, /) -> None: ...
    @property
    def range(self) -> Range: ...
    @range.setter
    def range(self, arg: object, /) -> None: ...
    @property
    def left(self) -> int: ...
    @property
    def right(self) -> int: ...
    @property
    def direction(self) -> str: ...
    @property
    def is_resolvable(self) -> bool: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[Logic]: ...
    def __reversed__(self) -> Iterator[Logic]: ...
    def __contains__(self, arg: Logic, /) -> bool: ...
    @overload
    def __getitem__(self, arg: int, /) -> Logic: ...
    @overload
    def __getitem__(self, arg: slice, /) -> LogicArray: ...
    @overload
    def __setitem__(self, arg0: int, arg1: object, /) -> None: ...
    @overload
    def __setitem__(self, arg0: slice, arg1: object, /) -> None: ...
    def index(
        self, value: object, start: int | None = None, stop: int | None = None
    ) -> int: ...
    def count(self, arg: Logic, /) -> int: ...
    def __and__(self, arg: LogicArray, /) -> LogicArray: ...
    def __or__(self, arg: LogicArray, /) -> LogicArray: ...
    def __xor__(self, arg: LogicArray, /) -> LogicArray: ...
    def __invert__(self) -> LogicArray: ...
    @overload
    def __eq__(self, arg: LogicArray, /) -> bool: ...
    @overload
    def __eq__(self, arg: str, /) -> bool: ...
    @overload
    def __eq__(self, arg: int, /) -> bool: ...
    @overload
    def __eq__(self, arg: object, /) -> object: ...
    def resolve(self, resolver: str) -> LogicArray: ...
    def __str__(self) -> str: ...
    def __int__(self) -> object: ...
    def __bool__(self) -> bool: ...
    def __index__(self) -> object: ...
    def __repr__(self) -> str: ...
    def __copy__(self) -> LogicArray: ...
    def __deepcopy__(self, arg: dict, /) -> LogicArray: ...

